# Compose only. Copy to .env at repository root; never copy backend/.env.
# Generate three DIFFERENT random secrets (at least 32 bytes each).
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
JWT_SECRET=

# Only Nginx is published. Loopback keeps the app private to this computer.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
